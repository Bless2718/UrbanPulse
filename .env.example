POSTGRES_DB=urbanpulse
POSTGRES_USER=urbanpulse
POSTGRES_PASSWORD=urbanpulse_dev
DATABASE_URL=postgresql+pg8000://urbanpulse:urbanpulse_dev@localhost:5432/urbanpulse

NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Weather provider: open-meteo (default, no API key) or imd
WEATHER_PROVIDER=open-meteo
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
WEATHER_LATITUDE=13.0827
WEATHER_LONGITUDE=80.2707
WEATHER_LOCATION_NAME=Chennai
WEATHER_STATION_ID=open-meteo-chennai

# India Meteorological Department (optional; requires IMD-authorized access)
IMD_STATION_ID=43279
IMD_CURRENT_WEATHER_URL=https://mausam.imd.gov.in/api/current_wx_api.php

# Open Government Data Platform India
DATA_GOV_API_KEY=
DATA_GOV_ACCIDENT_RESOURCE_ID=
DATA_GOV_PAGE_SIZE=1000
